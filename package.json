{
  "name": "city-camp-xray-twin",
  "private": true,
  "version": "0.2.0",
  "description": "Edge-AI stormwater digital twin - City Camp Lagoon, Baguio City (MapLibre + Three.js X-Ray engine)",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "node scripts/start.mjs --setup",
    "start:frontend": "node scripts/start.mjs --no-backend",
    "start:prod": "node scripts/start.mjs --prod",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "generate:data": "python scripts/generate_citycamp_twin_data.py",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
